# Backend PostgreSQL URL. Use the VPS's private/local connection only on the server.
DATABASE_URL=postgresql+psycopg://mirrorflix_user:replace_me@127.0.0.1:5432/mirrorflix_db

# Allowed browser origins for FastAPI. Comma-separated; keep the production site origins.
CORS_ORIGINS=https://alterbucket.in,https://www.alterbucket.in,http://localhost:5173,http://127.0.0.1:5173

# Required only for the database-writing genre endpoint; keep this value secret.
API_ADMIN_TOKEN=replace_me_with_a_random_secret

# Optional frontend API origin. Empty means same-origin /api requests in production.
VITE_API_BASE_URL=
