# Browser-visible origin of the external genre database API (no /api suffix).
# Defaults to a same-origin relative path (''), so production requests go to
# https://alterbucket.in/api/genres and Nginx forwards to 127.0.0.1:8001.
# For local development over HTTP (no mixed-content concern), you may override
# this to reach a remote database API, e.g. http://103.235.105.231:8001.
VITE_API_BASE_URL=http://103.235.105.231:8001

# Same-origin path forwarded to the local Streambert service by Vite.
VITE_STREAMBERT_API_URL=/api/streambert

# Server-only Wyzie API key used by the backend for native-player subtitles.
SUBTITLES_FROM_WYZIE=your_wyzie_api_key

# Server-only TMDB API key used to resolve provider identifiers.
TMDB_KEY=your_tmdb_api_key

# Optional mutual-TLS credentials for authorized Aniwave requests.
# Keep certificate and private-key files outside the repository.
ANIWAVE_TLS_CERT_PATH=
ANIWAVE_TLS_KEY_PATH=
ANIWAVE_TLS_CA_PATH=
ANIWAVE_TLS_KEY_PASSWORD=