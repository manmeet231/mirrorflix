# External genre database used by the sync service.
API_BASE_URL=http://127.0.0.1:8001
ANILIST_API=https://graphql.anilist.co

HOST=127.0.0.1
PORT=8002
# Comma-separated browser origins, or * for a public API without credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
LOG_FILE=logs/sync.log

# Optional persistent catalog server, bound to loopback on port 8001.
# Set your own database URL privately; URL-encode special password characters.
DATABASE_URL=mysql+pymysql://catalog_user:REPLACE_ME@127.0.0.1:3306/alterbucket_catalog?charset=utf8mb4
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
CATALOG_WRITE_TOKEN=
# TMDB read-access bearer token (optional; needed only for TMDB imports).
TMDB_READ_TOKEN=
